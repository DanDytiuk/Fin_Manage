<Application x:Class="FinManage.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FinManage"
             xmlns:lochelp="clr-namespace:FinManage.Services"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="View/Windows/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <lochelp:LocalizationHelper x:Key="Loc"/>
            <lochelp:EnumLocalizationHelper x:Key="EnumLoc"/>
            <lochelp:VisibilityConverter x:Key="VisibleConvert"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
