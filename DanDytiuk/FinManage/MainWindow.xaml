<Window x:Class="FinManage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinManage"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть"></MenuItem>
            </MenuItem>
            <MenuItem Header="Настройки"></MenuItem>
            <MenuItem Header="О программе"></MenuItem>
            <MenuItem Header="Выход"></MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom"></StatusBar>
        <TabControl>
            <TabItem Header="Финансовая таблица">
                <DataGrid 
                    ItemsSource="{Binding}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="False"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    FontSize="16">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Месяц"
                                Binding="{Binding Month}"
                                IsReadOnly="True"/>

                        <DataGridTextColumn Header="Доход"
                                Binding="{Binding Income, StringFormat=N2}"/>

                        <DataGridTextColumn Header="Расходы"
                                Binding="{Binding Expenses, StringFormat=N2}"/>

                        <DataGridTextColumn Header="Сбережения"
                                Binding="{Binding Savings, StringFormat=N2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Список расходов"></TabItem>
            <TabItem></TabItem>
            <TabItem></TabItem>
            <TabItem></TabItem>
        </TabControl>
    </DockPanel>
</Window>
