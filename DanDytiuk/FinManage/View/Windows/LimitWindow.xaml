<Window x:Class="FinManage.View.Windows.LimitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinManage.View.Windows" xmlns:viewmodels="clr-namespace:FinManage.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:LimitWindowsViewModel}"
        xmlns:local_1="clr-namespace:FinManage.Models" xmlns:models="clr-namespace:FinManage.Models"
        mc:Ignorable="d"
        Title="{Binding [TitleLimit], Source={StaticResource Loc}}" Height="578" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="195*"></RowDefinition>
            <RowDefinition Height="185*"></RowDefinition>
            <RowDefinition Height="54*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" 
                Content="{Binding [Save], Source={StaticResource Loc}}" 
                Command="{Binding AddLimitCommand}" 
                HorizontalAlignment="Center" 
                Margin="0,10,0,0" 
                Grid.Row="2" 
                VerticalAlignment="Top" 
                Width="247"/>
        
        <Button Grid.Column="1" 
                Content="{Binding [Delete], Source={StaticResource Loc}}" 
                Command="{Binding DeleteLimitCommand}" 
                HorizontalAlignment="Center" 
                Margin="0,10,0,0" 
                Grid.Row="2" 
                VerticalAlignment="Top" 
                Width="246"/>
        
        <Button Grid.Column="2" 
                Content="{Binding [Cancel], Source={StaticResource Loc}}" 
                Command="{Binding CancelCommand}" 
                HorizontalAlignment="Center" 
                Margin="0,10,0,0" 
                Grid.Row="2" 
                VerticalAlignment="Top" 
                Width="246"/>

        <DataGrid Grid.ColumnSpan="2" 
                  Grid.RowSpan="2" 
                  Grid.Column="1" 
                  ItemsSource="{Binding Limits}" 
                  SelectedItem="{Binding SelectedLimit, Mode=TwoWay}" 
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="{Binding [Category], Source={StaticResource Loc}}"
                    Binding="{Binding CategoryDisplay}" 
                    IsReadOnly="True"/>
                <DataGridTextColumn
                    Header="{Binding [Amount], Source={StaticResource Loc}}"
                    Binding="{Binding Amount,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="True"/>
                <DataGridTextColumn
                    Header="{Binding [Currency], Source={StaticResource Loc}}" 
                    Binding="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="True"/>
                <DataGridTextColumn
                    Header="{Binding [Description], Source={StaticResource Loc}}"        
                    Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="True"/>
                <DataGridTextColumn
                    Header="{Binding [StartLimit], Source={StaticResource Loc}}"
                    Binding="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=dd.MM.yyyy}"
                    IsReadOnly="True"/>
                <DataGridTextColumn
                    Header="{Binding [EndLimit], Source={StaticResource Loc}}"
                    Binding="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=dd.MM.yyyy}"
                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <ComboBox HorizontalAlignment="Center" 
                  Width="200"  
                  ItemsSource="{Binding CategoryComboBox}"
                  SelectedItem="{Binding SelectedCategory}" 
                  Margin="0,50,0,0" 
                  VerticalAlignment="Top">

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
            
            </ComboBox>

            <TextBlock HorizontalAlignment="Center" 
                   Margin="0,20,0,0" 
                   TextAlignment="Center"
                   TextWrapping="Wrap" 
                   Text="{Binding [Category], Source={StaticResource Loc}}" 
                   VerticalAlignment="Top" Width="200"/>

        <TextBlock HorizontalAlignment="Center" 
                   TextAlignment="Center"
                   TextWrapping="Wrap" 
                   Text="{Binding [Amount], Source={StaticResource Loc}}" 
                   VerticalAlignment="Top" 
                   Margin="0,95,0,0" Width="200"/>
        
        <TextBox HorizontalAlignment="Center" 
                 Margin="0,126,0,0" 
                 TextWrapping="Wrap" 
                 Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='0', StringFormat=N2}" 
                 VerticalAlignment="Top" 
                 Width="200"/>

        <TextBlock HorizontalAlignment="Center" 
                   TextAlignment="Center"
                   TextWrapping="Wrap" 
                   Text="{Binding [Currency], Source={StaticResource Loc}}" 
                   VerticalAlignment="Top" 
                   Margin="0,169,0,0" 
                   Width="200"/>
        
        <ComboBox Margin="50,202,50,0" 
                  VerticalAlignment="Top" 
                  ItemsSource="{Binding CurrencyCB}" 
                  SelectedItem="{Binding Currency, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock HorizontalAlignment="Center" 
                   Margin="0,15,0,0" 
                   Grid.Row="1" 
                   TextAlignment="Center"
                   TextWrapping="Wrap" 
                   Text="{Binding [Description], Source={StaticResource Loc}}" 
                   VerticalAlignment="Top" Width="200"/>
        
        <TextBox HorizontalAlignment="Center" 
                 Margin="0,49,0,0" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Top" 
                 Width="200"/>

        <TextBlock HorizontalAlignment="Center" 
                   Margin="0,165,0,0" 
                   Grid.Row="1" 
                   TextAlignment="Center"
                   TextWrapping="Wrap" 
                   Text="{Binding [EndLimit], Source={StaticResource Loc}}" 
                   VerticalAlignment="Top" Width="200"/>

        <TextBlock HorizontalAlignment="Center" 
                   Margin="0,94,0,0" 
                   Grid.Row="1" 
                   TextAlignment="Center"
                   TextWrapping="Wrap" 
                   Text="{Binding [StartLimit], Source={StaticResource Loc}}" 
                   VerticalAlignment="Top" Width="200" />

    </Grid>
</Window>
