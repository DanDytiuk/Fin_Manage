<Window x:Class="FinManage.View.Windows.LimitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinManage.View.Windows" xmlns:viewmodels="clr-namespace:FinManage.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:LimitWindowsViewModel}"
        xmlns:local_1="clr-namespace:FinManage.Models" xmlns:models="clr-namespace:FinManage.Models"
        mc:Ignorable="d"
        Title="LimitWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="195*"></RowDefinition>
            <RowDefinition Height="185*"></RowDefinition>
            <RowDefinition Height="54*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Save limit" Command="{Binding AddLimitCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="2" VerticalAlignment="Top" Width="247"/>
        <Button Grid.Column="1" Content="Delete limit" Command="{Binding DeleteLimitCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="2" VerticalAlignment="Top" Width="246"/>
        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="2" VerticalAlignment="Top" Width="246"/>
        <DataGrid Grid.ColumnSpan="2" Grid.RowSpan="2" Grid.Column="1" ItemsSource="{Binding Limits}" SelectedItem="{Binding SelectedLimit, Mode=TwoWay}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn
            Header="Category"
            Binding="{Binding Category}" 
            IsReadOnly="True"/>

                <DataGridTextColumn
            Header="Monthly Limit"
            Binding="{Binding MonthlyLimit,
                              Mode=TwoWay,
                              UpdateSourceTrigger=PropertyChanged}"
            IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <ComboBox HorizontalAlignment="Center" Width="120" RenderTransformOrigin="0.511,0.56" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,50,0,0" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" Text="Category" VerticalAlignment="Top"/>

        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Amount" VerticalAlignment="Center"/>
        <TextBox HorizontalAlignment="Center" Margin="0,133,0,0" TextWrapping="Wrap" Text="{Binding Amount, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged, FallbackValue='0'}" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
