<Window x:Class="FinManage.View.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinManage.View.Windows" 
        xmlns:viewmodels="clr-namespace:FinManage.ViewModels" 
        xmlns:infrastracture="clr-namespace:FinManage.Infrastructure" d:DataContext="{d:DesignInstance Type=viewmodels:SettingsWindowsViewModel}"
        mc:Ignorable="d"
        Title="Settings FinManage" Height="400" Width="500">
    <Grid>
        <Button Content="Save" HorizontalAlignment="Left" Margin="20,342,0,0" VerticalAlignment="Top" Width="100"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="390,342,0,0" VerticalAlignment="Top" Width="100"/>
        <TextBlock HorizontalAlignment="Left" Margin="45,10,0,0" TextWrapping="Wrap" Text="Theme" VerticalAlignment="Top"/>
        <ComboBox HorizontalAlignment="Left" Margin="20,31,0,0" VerticalAlignment="Top" Width="85" ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Theme}"/>
        <ComboBox HorizontalAlignment="Left" Margin="20,106,0,0" VerticalAlignment="Top" Width="85" ItemsSource="{Binding Currency}" SelectedItem="{Binding Settings.Currency}"/>
        <TextBox HorizontalAlignment="Left" Margin="33,69,0,0" TextWrapping="Wrap" Text="Currency" VerticalAlignment="Top"/>

    </Grid>
</Window>
