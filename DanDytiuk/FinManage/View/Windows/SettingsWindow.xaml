<Window x:Class="FinManage.View.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinManage.View.Windows" 
        xmlns:viewmodels="clr-namespace:FinManage.ViewModels" 
        xmlns:infrastracture="clr-namespace:FinManage.Infrastructure" d:DataContext="{d:DesignInstance Type=viewmodels:SettingsWindowsViewModel}"
        mc:Ignorable="d"
        Title="Settings FinManage" Height="200" Width="500">
    <Grid Background="SpringGreen" Margin="0,0,0,-61">

        <Button Content="Save" 
                HorizontalAlignment="Left" 
                Margin="93,97,0,0" 
                VerticalAlignment="Top" 
                Width="100" 
                Command="{Binding SaveCommand}"/>
        
        <Button Content="Cancel" 
                HorizontalAlignment="Left" 
                Margin="245,97,0,0" 
                VerticalAlignment="Top" 
                Width="100" 
                Command="{Binding CancelCommand}"/>

        <TextBlock HorizontalAlignment="Left" 
                   Margin="196,10,0,0" 
                   TextWrapping="Wrap" 
                   Text="Currency" 
                   VerticalAlignment="Top"/>
        
        <TextBlock HorizontalAlignment="Left" 
                   Margin="45,10,0,0" 
                   TextWrapping="Wrap" 
                   Text="Theme" 
                   VerticalAlignment="Top"/>
        
        <TextBlock HorizontalAlignment="Left" 
                   Margin="352,10,0,0" 
                   TextWrapping="Wrap" 
                   Text="Language" 
                   VerticalAlignment="Top"/>

        <ComboBox HorizontalAlignment="Left" 
                  Margin="20,31,0,0" 
                  VerticalAlignment="Top" 
                  Width="85" 
                  ItemsSource="{Binding Themes}" 
                  SelectedItem="{Binding Settings.Theme, Mode=TwoWay}"/>
        
        <ComboBox HorizontalAlignment="Left" 
                  Margin="177,31,0,0" 
                  VerticalAlignment="Top" 
                  Width="85" 
                  ItemsSource="{Binding Currency}" 
                  SelectedItem="{Binding Settings.Currency, Mode=TwoWay}"/>
        
        <ComboBox HorizontalAlignment="Left" 
                  Width="85" 
                  Margin="335,31,0,0" 
                  VerticalAlignment="Top" 
                  ItemsSource="{Binding LanguagesCB}" 
                  SelectedItem="{Binding Settings.Language, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"/>
    
    </Grid>
</Window>
