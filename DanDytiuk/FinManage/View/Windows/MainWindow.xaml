<Window x:Class="FinManage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinManage.ViewModels"
        xmlns:local="clr-namespace:FinManage"
        xmlns:services="clr-namespace:FinManage.Services"
        xmlns:pro="clr-namespace:FinManage.Properties"
        mc:Ignorable="d"
        Title="{Binding [Title], Source={StaticResource Loc}}" Height="900" Width="1600">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="Gold">
            <MenuItem Header="{Binding [LimitsMenuBar], Source={StaticResource Loc}}" Command="{Binding OpenLimitsCommand}"></MenuItem>
            <MenuItem Header="{Binding [SettingsMenuBar], Source={StaticResource Loc}}" Command="{Binding OpenSettingsCommand}"></MenuItem>
            <MenuItem Header="{Binding [AboutTabControl], Source={StaticResource Loc}}"></MenuItem>
            <MenuItem Header="{Binding [ExitFromFinManage], Source={StaticResource Loc}}" Command="{Binding CloseAppCommand}"></MenuItem>
        </Menu>
        <TabControl>
            <TabItem Header="{Binding [FinTableTabControl], Source={StaticResource Loc}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9*"/>
                        <ColumnDefinition Width="16*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="8,50,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Category], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Height="16" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,80,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Currency], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Height="16" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="8,169,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Amount], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Height="16" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,199,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Description], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Height="16" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="8,19,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [OperationType], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Height="16" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,139,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [NameOfAmount], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Height="16" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,110,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [DateData], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Height="16" 
                               Width="120"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="140,45,0,0" 
                              VerticalAlignment="Top" 
                              Width="120" 
                              ItemsSource="{Binding IncomeCategories}" 
                              DisplayMemberPath="DisplayName" 
                              SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Height="25"
                              Visibility="{Binding IsIncomeVisible, Converter={StaticResource VisibleConvert}}"/>

                    <ComboBox HorizontalAlignment="Left"
                              Margin="280,45,0,0"
                              VerticalAlignment="Top"
                              Width="120" 
                              Height="25"
                              ItemsSource="{Binding ExpensesCategories}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding IsExpenseVisible, Converter={StaticResource VisibleConvert}}"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="140,15,0,0" 
                              VerticalAlignment="Top" 
                              Width="260" 
                              ItemsSource="{Binding OperationTypes}" 
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Type"
                              SelectedValue="{Binding TypeOperation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Height="25"/>


                    <ComboBox HorizontalAlignment="Left" 
                              Margin="140,75,0,0" 
                              VerticalAlignment="Top"
                              Width="260" 
                              ItemsSource="{Binding CurrencyCB, Mode=OneWay}" 
                              SelectedItem="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='-'}" 
                              Height="25"/>

                    <TextBox HorizontalAlignment="Left" 
                             Margin="140,135,0,0" 
                             TextWrapping="NoWrap" 
                             Text="{Binding NameOfAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalAlignment="Top" 
                             Width="260" 
                             Height="25" />

                    <TextBox HorizontalAlignment="Left" 
                             Margin="140,165,0,0" 
                             TextWrapping="Wrap" 
                             Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='0', StringFormat=N2}"  
                             VerticalAlignment="Top" 
                             Width="260" 
                             Height="25"/>

                    <TextBox HorizontalAlignment="Left" 
                             Margin="140,195,0,0" 
                             TextWrapping="NoWrap" 
                             Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalAlignment="Top" 
                             Width="260" 
                             Height="25"/>

                    <DatePicker HorizontalAlignment="Left" 
                                Margin="140,106,0,0" 
                                VerticalAlignment="Top" 
                                Height="24" 
                                Width="260" 
                                SelectedDate="{Binding DataTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                DisplayDateStart="{Binding MinDate, Mode=OneWay}" 
                                DisplayDateEnd="{Binding MaxDate, Mode=OneWay}"/>

                    <Button Content="{Binding [SaveNewInfo], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Margin="140,238,0,0" 
                            VerticalAlignment="Top" 
                            Width="260" 
                            Command="{Binding AddFinDataInfoCommand}" 
                            Height="32" 
                            IsDefault="True"/>

                    <Button Content="{Binding [DeleteInfo], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" 
                            Width="260" 
                            Margin="140,281,0,0" 
                            Command="{Binding DeleteFinDataInfoCommand}" 
                            Height="32"/>

                    <Button Content="{Binding [ChangeInfo], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" 
                            Width="260" 
                            Margin="140,324,0,0" 
                            Height="32"/>

                    <DataGrid Grid.Column="1" 
                              AutoGenerateColumns="False" 
                              ItemsSource="{Binding MainFinAllTableColection}" 
                              SelectedItem="{Binding SelectedFinManage, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="{Binding [Category], Source={StaticResource Loc}}"
                                Binding="{Binding CategoryDisplay}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [OperationType], Source={StaticResource Loc}}"
                                Binding="{Binding OperationTypeDisplay}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [NameOfAmount], Source={StaticResource Loc}}"
                                Binding="{Binding NameOfAmount}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [Amount], Source={StaticResource Loc}}"
                                Binding="{Binding Amount}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [Currency], Source={StaticResource Loc}}"
                                Binding="{Binding Currency}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [DateData], Source={StaticResource Loc}}"
                                Binding="{Binding DateInfo, StringFormat=dd.MM.yyyy}"
                                IsReadOnly="True"
                                Width="100"/>
                            <DataGridTextColumn
                                Header="{Binding [Description], Source={StaticResource Loc}}"
                                Binding="{Binding Description}"
                                IsReadOnly="True"/>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>
            <TabItem Header="{Binding [AnalyseExpenses], Source={StaticResource Loc}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                        <ColumnDefinition Width="13*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,25,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Month], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" Width="120"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="10,50,0,0" 
                              VerticalAlignment="Top" 
                              Width="120" 
                              ItemsSource="{Binding Months, Mode=OneWay}" 
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ValueMonth"
                              SelectedItem="{Binding SelectedMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="221,50,0,0" 
                              VerticalAlignment="Top" 
                              Width="120" 
                              ItemsSource="{Binding YearsCB, Mode=OneWay}" 
                              SelectedItem="{Binding SelectedYearCB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGrid Grid.Column="1" 
                              AutoGenerateColumns="False" 
                              ItemsSource="{Binding StatisticsList, Mode=OneWay}" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn 
                                Header="{Binding [Category], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding CategoryLocalize}"/>
                            <DataGridTextColumn 
                                Header="{Binding [MinimalAmount], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding MinAmount}"/>
                            <DataGridTextColumn 
                                Header="{Binding [AverageAmount], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding AvgAmount}"/>
                            <DataGridTextColumn 
                                Header="{Binding [MaximumAmount], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding MaxAmount}"/>
                            <DataGridTextColumn 
                                Header="{Binding [TotalAmount], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding TotalAmount}"/>
                            <DataGridTextColumn 
                                Header="{Binding [AmountLimit], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding Limit}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="221,25,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Year], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,113,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Currency], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" Width="120"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="10,151,0,0" 
                              VerticalAlignment="Top" 
                              Width="120" 
                              ItemsSource="{Binding CurrencyCB, Mode=OneWay}" 
                              SelectedItem="{Binding SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="{Binding [GoAnalyse], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Margin="188,99,0,0" 
                            VerticalAlignment="Top" 
                            Width="153" 
                            Command="{Binding GoInfoCommand}"/>

                    <DataGrid ItemsSource="{Binding ValueListIncome}" Margin="0,248,0,426" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" >
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="{Binding [Month], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding SelectedMonth}"
                                Width="100"/>
                            <DataGridTextColumn
                                Header="{Binding [Year], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding SelectedYear}"
                                Width="100"/>
                            <DataGridTextColumn
                                Header="{Binding [Currency], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding SelectedCurrency}"
                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="{Binding [CleanAnalyse], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Margin="189,144,0,0" 
                            VerticalAlignment="Top" 
                            Width="152" 
                            Command="{Binding CleanCBCommand}"/>

                    <Button Content="{Binding [RefreshAnalyse], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Margin="190,195,0,0" 
                            VerticalAlignment="Top" 
                            Width="152" 
                            Command="{Binding RefreshInfoCommand}"/>

                </Grid>
            </TabItem>
            <TabItem Header="{Binding [AnalyseIncome], Source={StaticResource Loc}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                        <ColumnDefinition Width="13*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,25,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Month], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" Width="120"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="10,50,0,0" 
                              VerticalAlignment="Top" 
                              Width="120" 
                              ItemsSource="{Binding Months, Mode=OneWay}" 
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ValueMonth"
                              SelectedItem="{Binding SelectedMonthIncomeCB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="221,50,0,0" 
                              VerticalAlignment="Top" 
                              Width="120" 
                              ItemsSource="{Binding YearsCB, Mode=OneWay}" 
                              SelectedItem="{Binding SelectedYearIncomeCB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGrid Grid.Column="1" 
                              AutoGenerateColumns="False" 
                              ItemsSource="{Binding StatisticsListIncome, Mode=OneWay}" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn 
                                Header="{Binding [Category], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding CategoryLocalize}"/>
                            <DataGridTextColumn 
                                Header="{Binding [MinimalAmount], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding MinAmount}"/>
                            <DataGridTextColumn 
                                Header="{Binding [AverageAmount], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding AvgAmount}"/>
                            <DataGridTextColumn 
                                Header="{Binding [MaximumAmount], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding MaxAmount}"/>
                            <DataGridTextColumn 
                                Header="{Binding [TotalAmount], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding TotalAmount}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="221,25,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Year], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,113,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [Currency], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" Width="120"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="10,151,0,0" 
                              VerticalAlignment="Top" 
                              Width="120" 
                              ItemsSource="{Binding CurrencyCB, Mode=OneWay}" 
                              SelectedItem="{Binding SelectedCurrencyIncomeCB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="{Binding [GoAnalyse], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Margin="188,99,0,0" 
                            VerticalAlignment="Top" 
                            Width="153" 
                            Command="{Binding GoInfoIncomeCommand}"/>

                    <DataGrid ItemsSource="{Binding ValueListIncome}" 
                              Margin="0,248,0,426" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="{Binding [Month], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding SelectedMonth}"
                                Width="100"/>
                            <DataGridTextColumn
                                Header="{Binding [Year], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding SelectedYear}"
                                Width="100"/>
                            <DataGridTextColumn
                                Header="{Binding [Currency], Source={StaticResource Loc}}"
                                IsReadOnly="True"
                                Binding="{Binding SelectedCurrency}"
                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="{Binding [CleanAnalyse], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Margin="189,144,0,0" 
                            VerticalAlignment="Top" 
                            Width="152" 
                            Command="{Binding CleanCBIncomeCommand}"/>

                    <Button Content="{Binding [RefreshAnalyse], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Margin="190,195,0,0" 
                            VerticalAlignment="Top" 
                            Width="152" 
                            Command="{Binding RefreshInfoIncomeCommand}"/>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding [Filters], Source={StaticResource Loc}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"></ColumnDefinition>
                        <ColumnDefinition Width="11*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="1"
                              ItemsSource="{Binding FilterFinCollection}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="{Binding [Category], Source={StaticResource Loc}}"
                                Binding="{Binding CategoryDisplay}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [OperationType], Source={StaticResource Loc}}"
                                Binding="{Binding OperationTypeDisplay}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [NameOfAmount], Source={StaticResource Loc}}"
                                Binding="{Binding NameOfAmount}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [Amount], Source={StaticResource Loc}}"
                                Binding="{Binding Amount}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [Currency], Source={StaticResource Loc}}"
                                Binding="{Binding Currency}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="{Binding [DateData], Source={StaticResource Loc}}"
                                Binding="{Binding DateInfo, StringFormat=dd.MM.yyyy}"
                                IsReadOnly="True"
                                Width="100"/>
                            <DataGridTextColumn
                                 Header="{Binding [Description], Source={StaticResource Loc}}"
                                 Binding="{Binding Description}"
                                 IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox HorizontalAlignment="Left" 
                             Margin="26,40,0,0" 
                             TextWrapping="Wrap" 
                             Text="{Binding FilterAmountFrom, Mode=TwoWay}" 
                             VerticalAlignment="Top" 
                             Width="120"/>

                    <TextBox HorizontalAlignment="Left" 
                             Margin="326,40,0,0" 
                             TextWrapping="Wrap" 
                             Text="{Binding FilterAmountTo, Mode=TwoWay}" 
                             VerticalAlignment="Top" 
                             Width="120"/>

                    <TextBox HorizontalAlignment="Left" 
                             Margin="30,205,0,0" 
                             TextWrapping="Wrap" 
                             Text="{Binding FilterShopName, Mode=TwoWay}" 
                             VerticalAlignment="Top" 
                             Width="120"/>

                    <DatePicker HorizontalAlignment="Left" 
                                Margin="30,296,0,0" 
                                VerticalAlignment="Top" 
                                Width="120"
                                DisplayDateStart="{Binding MinDate, Mode=OneWay}"
                                DisplayDateEnd="{Binding MaxDate, Mode=OneWay}"
                                SelectedDate="{Binding FilterDateFrom, Mode=TwoWay}"/>

                    <DatePicker HorizontalAlignment="Left" 
                                Margin="326,296,0,0" 
                                VerticalAlignment="Top" 
                                Width="120"
                                DisplayDateStart="{Binding MinDate, Mode=OneWay}"
                                DisplayDateEnd="{Binding MaxDate, Mode=OneWay}"
                                SelectedDate="{Binding FilterDateTo, Mode=TwoWay}"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="326,205,0,0" 
                              VerticalAlignment="Top" 
                              Width="120"
                              ItemsSource="{Binding CurrencyCB}"
                              SelectedValue="{Binding FilterCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="26,121,0,0" 
                              VerticalAlignment="Top" 
                              Width="120"
                              ItemsSource="{Binding FullCategories}"
                              DisplayMemberPath="DisplayName"
                              SelectedValue="{Binding FilterCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox HorizontalAlignment="Left" 
                              Margin="326,121,0,0" 
                              VerticalAlignment="Top" 
                              Width="120"
                              ItemsSource="{Binding OperationTypes}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Type"
                              SelectedItem="{Binding FilterOperationType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox HorizontalAlignment="Center" 
                             TextWrapping="Wrap" 
                             Text="{Binding FilterDescription, Mode=TwoWay}" 
                             VerticalAlignment="Center" 
                             Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="26,10,0,0" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Text="{Binding [FilterFromAmount], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="326,10,0,0" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Text="{Binding [FilterToAmount], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="30,100,0,0" 
                               TextWrapping="Wrap" 
                               Text="{Binding [FilterCategory], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="290,98,0,0" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Text="{Binding [FilterOperationType], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Width="200"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="10,174,0,0" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Text="{Binding [FilterShopName], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Width="190"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="326,179,0,0" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Text="{Binding [FilterCurrency], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="30,266,0,0" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Text="{Binding [FilterFromDate], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="326,266,0,0" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Text="{Binding [FilterToDate], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Width="120"/>

                    <TextBlock HorizontalAlignment="Center" 
                               Margin="0,350,0,0" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Text="{Binding [FilterDescription], Source={StaticResource Loc}}" 
                               VerticalAlignment="Top" 
                               Width="200"/>

                    <Button Content="{Binding [Filter], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Command="{Binding GoFilterCommand}"
                            Margin="26,435,0,0" 
                            VerticalAlignment="Top" 
                            Width="200"/>

                    <Button Content="{Binding [CleanAnalyse], Source={StaticResource Loc}}" 
                            HorizontalAlignment="Left" 
                            Margin="250,435,0,0" 
                            Command="{Binding FilterCleanValueCommand}"
                            VerticalAlignment="Top" 
                            Width="200"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Command="{Binding CleanFilterCategoryCommand}"
                            Margin="159,127,0,0" 
                            VerticalAlignment="Top" 
                            Height="26" 
                            Width="41"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Command="{Binding CleanFilterAmountFromCommand}"
                            Margin="159,52,0,0" 
                            VerticalAlignment="Top" 
                            Height="26" 
                            Width="41"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Command="{Binding CleanFilterShopNameCommand}"
                            Margin="159,211,0,0" 
                            VerticalAlignment="Top" 
                            Height="26" 
                            Width="41"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Margin="159,302,0,0" 
                            VerticalAlignment="Top" 
                            Command="{Binding CleanFilterDateFromCommand}"
                            Height="26" 
                            Width="41"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Command="{Binding CleanFilterOperationTypeCommand}"
                            Margin="280,127,0,0" 
                            VerticalAlignment="Top" 
                            Height="26" 
                            Width="41"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Command="{Binding CleanFilterAmountToCommand}"
                            Margin="280,52,0,0" 
                            VerticalAlignment="Top" 
                            Height="26" 
                            Width="41"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Margin="280,211,0,0" 
                            VerticalAlignment="Top"
                            Command="{Binding CleanFilterCurrencyCommand}"
                            Height="26" 
                            Width="41"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Margin="280,302,0,0" 
                            VerticalAlignment="Top"
                            Command="{Binding CleanFilterDateToCommand}"
                            Height="26" 
                            Width="41"/>

                    <Button Content="Х" 
                            HorizontalAlignment="Left" 
                            Margin="326,375,0,0" 
                            VerticalAlignment="Top" 
                            Command="{Binding CleanFilterDescriptionCommand}"
                            Height="26" 
                            Width="41"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
