<Window x:Class="FinManage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinManage.ViewModels"
        xmlns:local="clr-namespace:FinManage"
        mc:Ignorable="d"
        Title="FinManage" Height="900" Width="1600">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="Gold">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть"></MenuItem>
            </MenuItem>
            <MenuItem Header="Лимиты" Command="{Binding OpenLimitsCommand}"></MenuItem>
            <MenuItem Header="Настройки" Command="{Binding OpenSettingsCommand}"></MenuItem>
            <MenuItem Header="О программе"></MenuItem>
            <MenuItem Header="Выход" Command="{Binding CloseAppCommand}"></MenuItem>
        </Menu>
        <TabControl>
            <TabItem Header="Финансовая таблица">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="321*"></ColumnDefinition>
                        <ColumnDefinition Width="1279*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Left" Margin="10,14,0,0" TextWrapping="Wrap" Text="Category" VerticalAlignment="Top" Height="16" Width="48"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,85,0,0" TextWrapping="Wrap" Text="Currency" VerticalAlignment="Top" Height="16" Width="47"/>
                    <TextBlock HorizontalAlignment="Left" Margin="9,193,0,0" TextWrapping="Wrap" Text="Amount" VerticalAlignment="Top" Height="16" Width="43"/>
                    <TextBlock HorizontalAlignment="Left" Margin="9,240,0,0" TextWrapping="Wrap" Text="Description" VerticalAlignment="Top" Height="16" Width="60"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,50,0,0" TextWrapping="Wrap" Text="Type of operation" VerticalAlignment="Top" Height="16" Width="94"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,152,0,0" TextWrapping="Wrap" Text="Name of amount" VerticalAlignment="Top" Height="16" Width="90"/>
                    <TextBlock HorizontalAlignment="Left" Margin="9,122,0,0" TextWrapping="Wrap" Text="Date operation" VerticalAlignment="Top" Height="16" Width="80"/>

                    <ComboBox x:Name="CategoryComboBox" HorizontalAlignment="Left" Margin="160,9,0,0" VerticalAlignment="Top" Width="120" ItemsSource="{Binding CategoriesCB, Mode=OneWay}" SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <ComboBox HorizontalAlignment="Left" Margin="160,45,0,0" VerticalAlignment="Top" Width="120" ItemsSource="{Binding OperationCB, Mode=OneWay}" SelectedItem="{Binding TypeOperation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <ComboBox HorizontalAlignment="Left" Margin="160,80,0,0" VerticalAlignment="Top" Width="120" ItemsSource="{Binding CurrencyCB, Mode=OneWay}" SelectedItem="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='-'}" Height="25"/>

                    <TextBox HorizontalAlignment="Left" Margin="160,147,0,0" TextWrapping="NoWrap" Text="{Binding NameOfAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="120" Height="25" />
                    <TextBox HorizontalAlignment="Left" Margin="160,188,0,0" TextWrapping="Wrap" Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='0', StringFormat=N2}"  VerticalAlignment="Top" Width="120" Height="25"/>
                    <TextBox HorizontalAlignment="Left" Margin="160,235,0,0" TextWrapping="NoWrap" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="120" Height="25"/>

                    <DatePicker HorizontalAlignment="Left" Margin="160,117,0,0" VerticalAlignment="Top" Height="25" Width="120" SelectedDate="{Binding DataTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateStart="{Binding MinDate, Mode=OneWay}" DisplayDateEnd="{Binding MaxDate, Mode=OneWay}"/>

                    <Button Content="Save Info" HorizontalAlignment="Center" Margin="0,275,0,0" VerticalAlignment="Top" Width="280" Command="{Binding AddFinDataInfoCommand}" Height="32"/>
                    <Button Content="Delete Info" HorizontalAlignment="Center" VerticalAlignment="Top" Width="280" Margin="0,320,0,0" Command="{Binding DeleteFinDataInfoCommand}" Height="32"/>
                    <Button Content="Change Info" HorizontalAlignment="Center" VerticalAlignment="Top" Width="280" Margin="0,362,0,0" Height="32"/>

                    <DataGrid Grid.Column="1" AutoGenerateColumns="False" ItemsSource="{Binding MainFinAllTableColection}" SelectedItem="{Binding SelectedFinManage, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Category"
                                Binding="{Binding Category}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="Operation Type"
                                Binding="{Binding OperationType}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="Name of Amount"
                                Binding="{Binding NameOfAmount}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="Amount"
                                Binding="{Binding Amount}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="Currency"
                                Binding="{Binding Currency}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn
                                Header="Date"
                                Binding="{Binding DateInfo, StringFormat=dd.MM.yyyy}"
                                IsReadOnly="True"
                                Width="100"/>
                            <DataGridTextColumn
                                Header="Description"
                                Binding="{Binding Description}"
                                IsReadOnly="True"/>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>
            <TabItem Header="Анализ расходов">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                        <ColumnDefinition Width="13*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Left" Margin="30,25,0,0" TextWrapping="Wrap" Text="Month of year" VerticalAlignment="Top"/>

                    <ComboBox HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Width="120" ItemsSource="{Binding Months, Mode=OneWay}" DisplayMemberPath="NameMonth" SelectedItem="{Binding SelectedMonthCB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox HorizontalAlignment="Left" Margin="221,50,0,0" VerticalAlignment="Top" Width="120" ItemsSource="{Binding YearsCB, Mode=OneWay}" SelectedItem="{Binding SelectedYearCB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGrid Grid.Column="1" AutoGenerateColumns="False" ItemsSource="{Binding StatisticsList, Mode=OneWay}" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn 
                                Header="Category"
                                IsReadOnly="True"
                                Binding="{Binding Category}"/>
                            <DataGridTextColumn 
                                Header="Minimal amount"
                                IsReadOnly="True"
                                Binding="{Binding MinAmount}"/>
                            <DataGridTextColumn 
                                Header="Average amount"
                                IsReadOnly="True"
                                Binding="{Binding AvgAmount}"/>
                            <DataGridTextColumn 
                                Header="Maximun amount"
                                IsReadOnly="True"
                                Binding="{Binding MaxAmount}"/>
                            <DataGridTextColumn 
                                Header="Total amount"
                                IsReadOnly="True"
                                Binding="{Binding TotalAmount}"/>
                            <DataGridTextColumn 
                                Header="Amount of limit"
                                IsReadOnly="True"
                                Binding="{Binding Limit}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock HorizontalAlignment="Left" Margin="270,25,0,0" TextWrapping="Wrap" Text="Year" VerticalAlignment="Top"/>
                    <TextBlock HorizontalAlignment="Left" Margin="24,113,0,0" TextWrapping="Wrap" Text="Currency for filter" VerticalAlignment="Top"/>

                    <ComboBox HorizontalAlignment="Left" Margin="10,151,0,0" VerticalAlignment="Top" Width="120" ItemsSource="{Binding CurrencyCB, Mode=OneWay}" SelectedItem="{Binding SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Go" HorizontalAlignment="Left" Margin="188,99,0,0" VerticalAlignment="Top" Width="153" Command="{Binding GoInfoCommand}"/>

                    <DataGrid ItemsSource="{Binding ValueList}" Margin="0,248,0,426" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" >
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Month"
                                IsReadOnly="True"
                                Binding="{Binding SelectedMonth}"
                                Width="100"/>
                            <DataGridTextColumn
                                Header="Year"
                                IsReadOnly="True"
                                Binding="{Binding SelectedYear}"
                                Width="100"/>
                            <DataGridTextColumn
                                Header="Currency"
                                IsReadOnly="True"
                                Binding="{Binding SelectedCurrency}"
                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Clean" HorizontalAlignment="Left" Margin="189,144,0,0" VerticalAlignment="Top" Width="152" Command="{Binding CleanCBCommand}"/>
                    <Button Content="Refresh" HorizontalAlignment="Left" Margin="190,195,0,0" VerticalAlignment="Top" Width="152" Command="{Binding RefreshInfoCommand}"/>

                </Grid>
            </TabItem>
            <TabItem Header="Детальный анализ расходов">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="13*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Фильтры">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"></ColumnDefinition>
                        <ColumnDefinition Width="11*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Конвертер"></TabItem>


        </TabControl>
    </DockPanel>
</Window>
